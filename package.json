{
  "name": "hogproduktion-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "dotenv -e .env -- npx prisma generate",
    "prisma:watch": "dotenv -e .env -- npx prisma generate --watch",
    "prisma:migrate": "dotenv -e .env -- npx prisma migrate dev",
    "prisma:studio": "dotenv -e .env -- npx prisma studio",
    "prisma:seed": "dotenv -e .env -- npx tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.553.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "prisma": "^6.19.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.6",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
